  "query": "SELECT id, occurred_at, kind, title, value, unit, note, source FROM health_records\n        WHERE user_id=$1 AND ($2='' OR strpos(lower(concat_ws(' ',kind,title,value,unit,note,source)),lower($2))>0)\n        ORDER BY occurred_at DESC, id DESC LIMIT 50 OFFSET $3",
